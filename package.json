{
  "name": "gym-saas-backend",
  "version": "0.1.0",
  "description": "Backend do SaaS de Academias - NestJS + PostgreSQL",
  "author": "Fabio Aluizio",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "node scripts/lint.mjs && npm run typecheck",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:smoke": "node --test test/*.test.mjs",
    "test:cov": "npm run build && node --experimental-test-coverage --test test/*.test.mjs",
    "ci": "npm run lint && npm run build && npm run test:smoke",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "prisma": {
    "schema": "./prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
