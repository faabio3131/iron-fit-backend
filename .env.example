NODE_ENV=development
IRON_RUNTIME_ENV=DEV
# Build/release identity. IRON_BUILD_SHA is mandatory for production-shaped HOMOLOG/PROD.
IRON_BUILD_SHA=
IRON_RELEASE_VERSION=
PORT=3333
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_saas?schema=public
JWT_SECRET=dev_secret_trocar_em_producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_trocar_em_producao
JWT_REFRESH_EXPIRES_IN=30d
MFA_ISSUER=GymSaaS
REDIS_URL=redis://localhost:6379
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Required with >=32 chars when NODE_ENV=production in HOMOLOG/PROD.
OBSERVABILITY_METRICS_TOKEN=

# Commercial trial policy is governed by the APPROVED Commercial Launch Matrix
# in PostgreSQL (trial plan version + trial days). No deploy-time plan policy here.

# Block 3 — FM -> academy SaaS billing.
# INTERNAL_SANDBOX is strictly non-production and requires an explicit >=32-char secret.
# Production must use a separately implemented and homologated provider adapter; otherwise billing fails closed.
SAAS_BILLING_PROVIDER=INTERNAL_SANDBOX
SAAS_BILLING_SANDBOX_ENABLED=false
SAAS_BILLING_SANDBOX_SECRET=
# Invoice due days and dunning grace are governed by the APPROVED Commercial Launch Matrix.

# Block 4 — Commercial identity/security.
# Generate both encryption keys as independent 32-byte random secrets (hex64 or base64).
# No real secret belongs in the repository.
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_ACTION_TOKEN_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=
# Configure non-zero only when the real reverse-proxy topology is verified.
TRUST_PROXY_HOPS=0

# Macro G — transactional e-mail delivery.
# Leave disabled until a real GLOBAL provider connection with capability email.transactional
# is configured through IntegrationConnection + Vault and the sender domain is homologated.
TRANSACTIONAL_EMAIL_DISPATCH_ENABLED=false


# Commercial Readiness C4 — Integration Secret Vault.
# DISABLED keeps the fail-closed adapter. OCI enables the physical Oracle Cloud Vault backend.
# No tenant/client credential belongs in these variables.
INTEGRATION_SECRET_VAULT_BACKEND=DISABLED
OCI_VAULT_AUTH_MODE=INSTANCE_PRINCIPAL
OCI_VAULT_COMPARTMENT_ID=
OCI_VAULT_ID=
OCI_VAULT_KEY_ID=
# CONFIG_FILE is development/homologation only and is rejected when NODE_ENV=production.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
