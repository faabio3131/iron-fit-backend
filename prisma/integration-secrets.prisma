enum IntegrationScope {
  GLOBAL
  TENANT
}

enum IntegrationEnvironment {
  DEV
  HOMOLOG
  PROD
}

enum IntegrationConnectionStatus {
  PENDING
  ACTIVE
  DEGRADED
  SUSPENDED
  DISCONNECTED
}

enum IntegrationSecretCleanupStatus {
  PENDING
  COMPLETED
}

enum IntegrationBreakGlassStatus {
  REQUESTED
  APPROVED
  EXECUTING
  CONSUMED
  FAILED
  REVOKED
  EXPIRED
}

enum IntegrationBreakGlassOperation {
  PROVIDER_VERIFY
}

model IntegrationConnection {
  id                  String                       @id @default(uuid())
  scope               IntegrationScope
  gymId               String?
  providerCode        String
  environment         IntegrationEnvironment
  authModel           String
  status              IntegrationConnectionStatus @default(PENDING)
  capabilities        Json
  publicConfiguration Json?
  secretReference     String?
  secretVersion       Int?
  secretRotatedAt     DateTime?
  secretExpiresAt     DateTime?
  secretLastUsedAt    DateTime?
  secretRevokedAt     DateTime?
  createdByUserId     String?
  lastVerifiedAt      DateTime?
  oauthAppConnectionId String?
  oauthAccessExpiresAt DateTime?
  oauthGrantedScopes   Json?
  oauthRefreshCapable  Boolean                      @default(false)
  oauthRefreshLeaseOwner String?
  oauthRefreshLeaseUntil DateTime?
  oauthRefreshRetryAt  DateTime?
  oauthRefreshFailureCount Int                      @default(0)
  oauthLastRefreshAt   DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  cleanupTasks         IntegrationSecretCleanupTask[]
  breakGlassGrants      IntegrationBreakGlassGrant[]
  oauthAuthorizationAttempts IntegrationOAuthAuthorizationAttempt[]
  oauthAppConnection   IntegrationConnection?       @relation("IntegrationOAuthAppBinding", fields: [oauthAppConnectionId], references: [id], onDelete: SetNull)
  oauthTenantConnections IntegrationConnection[]    @relation("IntegrationOAuthAppBinding")

  @@index([scope, gymId, providerCode, environment])
  @@index([providerCode, environment, status])
  @@index([gymId, status])
  @@index([oauthAppConnectionId])
  @@index([oauthAccessExpiresAt, oauthRefreshRetryAt])
  @@index([oauthRefreshLeaseUntil])
}


model IntegrationSecretCleanupTask {
  id                      String                          @id @default(uuid())
  integrationConnectionId String?
  secretReference         String                          @unique
  reason                  String
  status                  IntegrationSecretCleanupStatus @default(PENDING)
  attempts                Int                             @default(1)
  lastAttemptAt           DateTime                        @default(now())
  completedAt             DateTime?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  connection              IntegrationConnection?          @relation(fields: [integrationConnectionId], references: [id], onDelete: SetNull)

  @@index([status, lastAttemptAt])
  @@index([integrationConnectionId, status])
}


model IntegrationBreakGlassGrant {
  id                      String                         @id @default(uuid())
  integrationConnectionId String
  operation               IntegrationBreakGlassOperation
  reason                  String
  requestedTtlSeconds     Int
  requestedByUserId       String
  approvedByUserId        String?
  status                  IntegrationBreakGlassStatus    @default(REQUESTED)
  approvedAt              DateTime?
  expiresAt               DateTime?
  executionStartedAt      DateTime?
  consumedAt              DateTime?
  failedAt                DateTime?
  revokedAt               DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  connection              IntegrationConnection          @relation(fields: [integrationConnectionId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([integrationConnectionId, status])
  @@index([requestedByUserId, createdAt])
}


model IntegrationOAuthAuthorizationAttempt {
  id                  String                 @id @default(uuid())
  connectionId        String
  appConnectionId     String
  providerCode        String
  environment         IntegrationEnvironment
  userId              String
  sessionId           String
  stateHash           String                 @unique
  redirectUri         String
  capabilities        Json
  scopes              Json
  pkceMode            String
  pkceSecretReference String?                @unique
  pkceSecretVersion   Int?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime               @default(now())
  connection          IntegrationConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([providerCode, environment])
}
