enum CreatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
}

enum CreatorIdentityStatus {
  UNVERIFIED
  VERIFIED
  REVOKED
}

enum CreatorRightsScope {
  GLOBAL
  TENANT
}

enum CreatorRightsHolderKind {
  CREATOR
  PERSON
  ORGANIZATION
  TENANT
}

enum CreatorRightsHolderStatus {
  ACTIVE
  RETIRED
}

enum CreatorManagedRelationKind {
  LICENSED_CONTENT
  IRON_OWNED
  TENANT_OWNED
}

enum CreatorRightsBasisKind {
  LICENSE
  ASSIGNMENT
  CONSENT
  OWNERSHIP_ATTESTATION
  OTHER
}

enum CreatorRightsGrantStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  SUSPENDED
  REVOKED
}

enum CreatorRightsConsentKind {
  CONTENT_USE
  LIKENESS
  VOICE
  PERFORMANCE
  OTHER
}

enum CreatorRightsConsentStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum CreatorMediaAssetKind {
  VIDEO
  AUDIO
  IMAGE
}

enum CreatorMediaIngestionStatus {
  PREPARED
  VERIFIED
  FAILED
}

enum CreatorMediaIngestionFailure {
  PROVIDER_PREPARE_FAILED
  PROVIDER_INSPECTION_FAILED
  OBJECT_NOT_FOUND
  INTEGRITY_HASH_UNAVAILABLE
  INTEGRITY_MISMATCH
  INVALID_OBJECT_SIZE
}

enum CreatorExerciseContentPlacement {
  PRIMARY
  ALTERNATIVE
}

enum CreatorExerciseContentPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum CreatorContentLifecycleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

enum CreatorContentVersionStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum CreatorContentModerationDecision {
  APPROVE
  REJECT
}

enum CreatorContentQualityVerdict {
  PASS
  FAIL
  NOT_APPLICABLE
}

model Creator {
  id                   String                 @id @default(uuid())
  slug                 String                 @unique
  displayName          String
  bio                  String?
  status               CreatorStatus          @default(PENDING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  identities           CreatorIdentity[]
  rightsHolderProfiles CreatorRightsHolder[]
  rightsConsents       CreatorRightsConsent[]
  contents             CreatorContent[]
  @@index([status, displayName])
}

model CreatorIdentity {
  id              String                @id @default(uuid())
  creatorId       String
  providerCode    String
  externalSubject String
  handle          String?
  profileUrl      String?
  status          CreatorIdentityStatus @default(UNVERIFIED)
  verifiedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  creator         Creator               @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  @@unique([providerCode, externalSubject])
  @@index([creatorId, status])
  @@index([providerCode, handle])
}

model CreatorRightsHolder {
  id                String                    @id @default(uuid())
  scope             CreatorRightsScope
  gymId             String?
  kind              CreatorRightsHolderKind
  creatorId         String?
  legalName         String
  externalReference String?
  fingerprint       String                    @unique
  status            CreatorRightsHolderStatus @default(ACTIVE)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  creator           Creator?                  @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  grantVersions     CreatorRightsGrantVersion[]
  @@index([scope, gymId, status])
  @@index([creatorId, status])
}

model CreatorRightsGrant {
  id           String                     @id @default(uuid())
  scope        CreatorRightsScope
  gymId        String?
  relationKind CreatorManagedRelationKind
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  versions     CreatorRightsGrantVersion[]
  contents     CreatorContent[]
  @@index([scope, gymId, relationKind])
}

model CreatorRightsGrantVersion {
  id                     String                   @id @default(uuid())
  grantId                String
  version                Int
  rightsHolderId         String
  basisKind              CreatorRightsBasisKind
  status                 CreatorRightsGrantStatus @default(DRAFT)
  usageScopes            String[]
  deliveryScopes         String[]
  territories            String[]
  validFrom              DateTime
  validUntil             DateTime?
  attributionRequired    Boolean                  @default(false)
  attributionText        String?
  evidenceReference      String
  evidenceSha256         String
  termsSha256            String?
  requiresCreatorConsent Boolean                  @default(false)
  fingerprint            String                   @unique
  activatedAt            DateTime?
  suspendedAt            DateTime?
  suspensionReason       String?
  revokedAt              DateTime?
  revocationReason       String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  grant                  CreatorRightsGrant       @relation(fields: [grantId], references: [id], onDelete: Restrict)
  rightsHolder           CreatorRightsHolder      @relation(fields: [rightsHolderId], references: [id], onDelete: Restrict)
  consents               CreatorRightsConsent[]
  @@unique([grantId, version])
  @@index([grantId, status])
  @@index([rightsHolderId, status])
}

model CreatorRightsConsent {
  id                String                     @id @default(uuid())
  grantVersionId    String
  creatorId         String
  kind              CreatorRightsConsentKind
  version           Int
  status            CreatorRightsConsentStatus @default(ACTIVE)
  purposeScopes     String[]
  validFrom         DateTime
  validUntil        DateTime?
  evidenceReference String
  evidenceSha256    String
  fingerprint       String                     @unique
  revokedAt         DateTime?
  revocationReason  String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  grantVersion      CreatorRightsGrantVersion  @relation(fields: [grantVersionId], references: [id], onDelete: Restrict)
  creator           Creator                    @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  @@unique([grantVersionId, creatorId, kind, version])
  @@index([grantVersionId, status])
  @@index([creatorId, status])
}

model CreatorContent {
  id            String                     @id @default(uuid())
  scope         CreatorRightsScope
  gymId         String?
  canonicalKey  String
  title         String
  description   String?
  relationKind  CreatorManagedRelationKind
  creatorId     String?
  rightsGrantId String
  fingerprint   String                     @unique
  lifecycleStatus CreatorContentLifecycleStatus @default(DRAFT)
  activatedAt     DateTime?
  suspendedAt     DateTime?
  retiredAt       DateTime?
  lifecycleReason String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  creator       Creator?                   @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  rightsGrant   CreatorRightsGrant         @relation(fields: [rightsGrantId], references: [id], onDelete: Restrict)
  mediaAssets   CreatorMediaAsset[]
  exerciseMappings CreatorExerciseContentMapping[]
  versions CreatorContentVersion[]
  @@index([scope, gymId, createdAt])
  @@index([scope, gymId, lifecycleStatus])
  @@index([creatorId, createdAt])
  @@index([rightsGrantId])
}

model CreatorMediaAsset {
  id              String                     @id @default(uuid())
  contentId       String
  kind            CreatorMediaAssetKind
  integritySha256 String
  mimeType        String
  durationMs      Int?
  width           Int?
  height          Int?
  languageCode    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  content         CreatorContent             @relation(fields: [contentId], references: [id], onDelete: Restrict)
  ingestions      CreatorMediaIngestion[]
  storageObjects  CreatorMediaStorageObject[]
  exerciseMappings CreatorExerciseContentMapping[]
  contentVersions CreatorContentVersion[]
  @@unique([contentId, integritySha256])
  @@index([contentId, kind])
  @@index([integritySha256])
}

model CreatorMediaIngestion {
  id             String                       @id @default(uuid())
  mediaAssetId   String
  providerCode   String
  objectKey      String
  requestKey     String
  fingerprint    String                       @unique
  status         CreatorMediaIngestionStatus  @default(PREPARED)
  failureCode    CreatorMediaIngestionFailure?
  preparedAt     DateTime                     @default(now())
  verifiedAt     DateTime?
  failedAt       DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  mediaAsset     CreatorMediaAsset            @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  storageObjects CreatorMediaStorageObject[]
  @@unique([mediaAssetId, requestKey])
  @@index([mediaAssetId, status])
  @@index([providerCode, status])
}

model CreatorMediaStorageObject {
  id                String                 @id @default(uuid())
  mediaAssetId      String
  sourceIngestionId String
  providerCode      String
  objectKey         String
  integritySha256   String
  sizeBytes         BigInt
  etag              String?
  verifiedAt        DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  mediaAsset        CreatorMediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  sourceIngestion   CreatorMediaIngestion  @relation(fields: [sourceIngestionId], references: [id], onDelete: Restrict)
  @@unique([mediaAssetId, providerCode])
  @@unique([providerCode, objectKey])
  @@index([mediaAssetId, verifiedAt])
  @@index([providerCode, verifiedAt])
}

model CreatorExerciseContentMapping {
  id              String                                  @id @default(uuid())
  scope           CreatorRightsScope
  gymId           String?
  exerciseId      String
  contentId       String
  mediaAssetId    String
  placement       CreatorExerciseContentPlacement         @default(PRIMARY)
  priority        Int                                     @default(100)
  status          CreatorExerciseContentPublicationStatus @default(DRAFT)
  fingerprint     String                                  @unique
  publishedAt     DateTime?
  unpublishedAt   DateTime?
  unpublishReason String?
  createdAt       DateTime                                @default(now())
  updatedAt       DateTime                                @updatedAt
  content         CreatorContent                          @relation(fields: [contentId], references: [id], onDelete: Restrict)
  mediaAsset      CreatorMediaAsset                       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  @@index([scope, gymId, exerciseId, status])
  @@index([contentId, status])
  @@index([mediaAssetId, status])
}

model CreatorContentVersion {
  id                   String                      @id @default(uuid())
  contentId            String
  version              Int
  mediaAssetId         String
  editorialTitle       String
  editorialDescription String?
  status               CreatorContentVersionStatus @default(DRAFT)
  fingerprint          String                      @unique
  reviewedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  content              CreatorContent              @relation(fields: [contentId], references: [id], onDelete: Restrict)
  mediaAsset           CreatorMediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  review               CreatorContentReview?
  @@unique([contentId, version])
  @@index([contentId, status, version])
  @@index([mediaAssetId, status])
}

model CreatorContentReview {
  id                   String                           @id @default(uuid())
  contentVersionId     String                           @unique
  decision             CreatorContentModerationDecision
  technicalQuality     CreatorContentQualityVerdict
  instructionalQuality CreatorContentQualityVerdict
  safetyQuality        CreatorContentQualityVerdict
  accessibilityQuality CreatorContentQualityVerdict
  notes                String?
  reviewerUserId       String
  reviewedAt           DateTime                         @default(now())
  createdAt            DateTime                         @default(now())
  version              CreatorContentVersion            @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  @@index([decision, reviewedAt])
  @@index([reviewerUserId, reviewedAt])
}
