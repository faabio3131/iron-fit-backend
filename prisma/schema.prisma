generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkoutStatus {
  DRAFT
  APPROVED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
}

enum ScheduleStatus {
  SCHEDULED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum AccessType {
  QR_CODE
  BIOMETRIC
  RFID
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum GatewayProvider {
  MERCADO_PAGO
  PAGBANK
  ASAAS
  STRIPE
  OTHER
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  SMS
  PUSH
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model Gym {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  document  String?
  email     String?
  phone     String?
  address   Json?
  timezone  String   @default("America/Sao_Paulo")
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRoles UserRole[]
  students  Student[]
  equipment Equipment[]
  scheduleSlots ScheduleSlot[]
  accessDevices AccessDevice[]
  accessEvents AccessEvent[]
  financialProfile FinancialProfile?
  financialAccounts FinancialAccount[]
  financialCategories FinancialCategory[]
  charges Charge[]
  communicationTemplates CommunicationTemplate[]
  communicationMessages CommunicationMessage[]
  communicationAutomations CommunicationAutomation[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[] @relation("AuditActor")
  student      Student?
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  gymId      String?
  assignedBy String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  gym        Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gymId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceName       String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  gymId      String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([gymId])
  @@index([actorId])
}

model Student {
  id               String        @id @default(uuid())
  gymId            String
  userId           String        @unique
  birthDate        DateTime?
  gender           String?
  goal             String?
  level            String?
  status           StudentStatus @default(ACTIVE)
  enrollmentDate   DateTime      @default(now())
  consentHealth    Boolean       @default(false)
  consentComm      Boolean       @default(false)
  consentBiometry  Boolean       @default(false)
  gym              Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments      Assessment[]
  workouts         Workout[]
  schedules        StudentSchedule[]
  accessCredentials AccessCredential[]
  accessEvents     AccessEvent[]
  charges          Charge[]
  communicationMessages CommunicationMessage[]

  @@index([gymId])
}

model Assessment {
  id             String   @id @default(uuid())
  studentId      String
  assessedById   String?
  weightKg       Float?
  heightCm       Float?
  bmi            Float?
  bodyFatPercent Float?
  measurements   Json?
  restrictions   Json?
  notes          String?
  createdAt      DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workouts       Workout[]
  @@index([studentId])
}

model Equipment {
  id            String @id @default(uuid())
  gymId         String
  name          String
  standardName  String?
  type          String?
  primaryMuscle String?
  secondaryMuscles Json?
  movementPattern String?
  difficulty    String?
  contraindications Json?
  videoUrl      String?
  active        Boolean @default(true)
  gym           Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  @@index([gymId])
}

model Exercise {
  id           String @id @default(uuid())
  name         String @unique
  muscleGroup  String?
  movement     String?
  level        String?
  videoUrl     String?
  contraindications Json?
  workoutExercises WorkoutExercise[]
}

model Workout {
  id            String        @id @default(uuid())
  studentId     String
  assessmentId  String?
  createdByAI   Boolean       @default(false)
  approvedById  String?
  status        WorkoutStatus @default(DRAFT)
  goal          String?
  level         String?
  weeklyFrequency Int?
  startDate     DateTime?
  validUntil    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment    Assessment?   @relation(fields: [assessmentId], references: [id])
  sessions      WorkoutSession[]
  @@index([studentId])
}

model WorkoutSession {
  id          String @id @default(uuid())
  workoutId   String
  name        String
  sessionType String?
  order       Int
  estimatedMinutes Int?
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
}

model WorkoutExercise {
  id            String @id @default(uuid())
  sessionId     String
  exerciseId    String
  equipmentId   String?
  order         Int
  sets          Int?
  reps          String?
  restSeconds   Int?
  suggestedLoad String?
  notes         String?
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  equipment     Equipment?     @relation(fields: [equipmentId], references: [id])
}

model ScheduleSlot {
  id        String @id @default(uuid())
  gymId     String
  weekday   Int
  startTime String
  endTime   String
  capacity  Int
  active    Boolean @default(true)
  gym       Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  schedules StudentSchedule[]
  @@index([gymId])
}

model StudentSchedule {
  id          String         @id @default(uuid())
  studentId   String
  slotId      String
  date        DateTime
  status      ScheduleStatus @default(SCHEDULED)
  checkedInAt DateTime?
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot        ScheduleSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  @@index([studentId])
}

model AccessDevice {
  id              String @id @default(uuid())
  gymId           String
  name            String
  type            AccessType
  protocol        String?
  ipAddress       String?
  active          Boolean @default(true)
  lastSyncAt      DateTime?
  deviceTokenHash String?
  tokenRotatedAt  DateTime?
  gym             Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  events          AccessEvent[]
  scanNonces      AccessScanNonce[]
}

model AccessScanNonce {
  id        String   @id @default(uuid())
  deviceId  String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  device    AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, nonce])
  @@index([expiresAt])
}

model AccessCredential {
  id            String   @id @default(uuid())
  studentId     String
  type          AccessType
  tokenHash     String?
  biometricHash String?
  active        Boolean  @default(true)
  expiresAt     DateTime?
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId])
}

model AccessEvent {
  id           String   @id @default(uuid())
  gymId        String
  studentId    String?
  deviceId     String?
  allowed      Boolean
  denialReason String?
  occurredAt   DateTime @default(now())
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student      Student? @relation(fields: [studentId], references: [id])
  device       AccessDevice? @relation(fields: [deviceId], references: [id])
  @@index([gymId])
}

model FinancialProfile {
  id               String @id @default(uuid())
  gymId            String @unique
  companyName      String
  tradeName        String?
  taxID            String?
  responsibleName  String?
  responsibleEmail String?
  responsiblePhone String?
  status           String @default("pending")
  gym              Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gatewayConnections GatewayConnection[]
}

model GatewayConnection {
  id               String @id @default(uuid())
  profileId        String
  provider         GatewayProvider
  mode             String @default("sandbox")
  authType         String
  merchantId       String?
  accountId        String?
  apiKeyEnc        String?
  accessTokenEnc   String?
  refreshTokenEnc  String?
  webhookSecretEnc String?
  status           String @default("disconnected")
  lastVerifiedAt   DateTime?
  profile          FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FinancialAccount {
  id             String @id @default(uuid())
  gymId          String
  name           String
  type           String
  initialBalance Int    @default(0)
  active         Boolean @default(true)
  gym            Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions   FinancialTransaction[]
}

model FinancialCategory {
  id           String @id @default(uuid())
  gymId        String
  name         String
  type         TransactionType
  color        String?
  active       Boolean @default(true)
  gym          Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id          String @id @default(uuid())
  gymId       String
  accountId   String
  categoryId  String?
  type        TransactionType
  description String
  amount      Int
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    FinancialCategory? @relation(fields: [categoryId], references: [id])

  @@index([gymId])
}

model Charge {
  id          String @id @default(uuid())
  gymId       String
  studentId   String
  description String
  amount      Int
  dueDate     DateTime
  status      ChargeStatus @default(PENDING)
  paidAt      DateTime?
  externalId  String?
  createdAt   DateTime @default(now())
  gym         Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([gymId])
  @@index([studentId])
}

model CommunicationTemplate {
  id        String @id @default(uuid())
  gymId     String
  name      String
  channel   CommunicationChannel
  title     String?
  body      String
  variables Json?
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  gym       Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  messages  CommunicationMessage[]
  @@index([gymId])
}

model CommunicationMessage {
  id         String @id @default(uuid())
  gymId      String
  studentId  String
  templateId String?
  channel    CommunicationChannel
  title      String?
  body       String
  status     CommunicationStatus @default(QUEUED)
  externalId String?
  error      String?
  createdAt  DateTime @default(now())
  sentAt     DateTime?
  gym        Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template   CommunicationTemplate? @relation(fields: [templateId], references: [id])
  @@index([gymId])
}

model CommunicationAutomation {
  id           String @id @default(uuid())
  gymId        String
  name         String
  triggerEvent String
  conditions   Json?
  actions      Json
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  gym          Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
  @@index([gymId])
}
