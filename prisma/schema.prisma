generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTION
  TRAINER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELED
}

enum WorkoutStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  EXPIRED
}

enum ScheduleStatus {
  SCHEDULED
  CHECKED_IN
  NO_SHOW
  CANCELED
}

enum AccessType {
  QR_CODE
  BIOMETRIC
  FACIAL
  TAG
  MANUAL
}

enum GatewayProvider {
  ASAAS
  MERCADO_PAGO
  PAGARME
  STRIPE
  EFI
  GERENCIANET
  IUGU
  VINDI
  MANUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum ChargeStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PLANNED
  PENDING
  PAID
  CANCELED
}

enum MessageChannel {
  PUSH
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELED
}

enum AggregatorConnectionStatus {
  PENDING
  ACTIVE
  DEGRADED
  SUSPENDED
  DISCONNECTED
}

enum AggregatorMembershipStatus {
  UNKNOWN
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

enum AggregatorAgreementStatus {
  REQUIRED
  SIGNED
  SUPERSEDED
  REVOKED
}

enum AggregatorEligibilityStatus {
  UNKNOWN
  ELIGIBLE
  INELIGIBLE
}

enum AggregatorVisitStatus {
  PENDING
  CONFIRMED
  DENIED
  PROVISIONAL
  FAILED
}

enum AggregatorProvisionalDecisionStatus {
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum AggregatorRevalidationStatus {
  PENDING
  CONFIRMED
  FAILED
  UNKNOWN
}

enum AggregatorSettlementStatus {
  EXPECTED
  CONFIRMED
  RECEIVED
  DIVERGENT
  DISPUTED
  EXPIRED
}

enum AggregatorReconciliationStatus {
  PENDING
  RECONCILED
  MISSING_PROVIDER_CHECKIN
  MISSING_PHYSICAL_ENTRY
  UNPAID_RISK
  AMOUNT_DIVERGENCE
  DUPLICATE
  MANUAL_REVIEW
}

enum AggregatorRiskStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum EquipmentCatalogCategory {
  CARDIO
  SELECTORIZED_STRENGTH
  PLATE_LOADED
  CABLE_FUNCTIONAL
  RACKS_BENCHES
  FREE_WEIGHTS
  FUNCTIONAL_CONDITIONING
  PILATES_REHAB
  SPECIALIZED_STRENGTH
}

enum EquipmentCatalogCandidateStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  name         String
  passwordHash String
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  userRoles    UserRole[]
  students     Student[]
  auditLogs    AuditLog[]
  productPreferences UserProductPreference[]
  equipmentCandidatesSubmitted EquipmentCatalogCandidate[] @relation("EquipmentCandidateSubmittedBy")
  equipmentCandidatesReviewed  EquipmentCatalogCandidate[] @relation("EquipmentCandidateReviewedBy")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash String
  deviceName       String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
}

model Role {
  id              String           @id @default(uuid())
  name            RoleName         @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  module          String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  gymId      String?
  assignedBy String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  gym        Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  gymId      String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  previous   Json?
  next       Json?
  ipAddress  String?
  deviceInfo String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([gymId])
}

model Gym {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  timezone  String   @default("America/Sao_Paulo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  userRoles UserRole[]
  students  Student[]
  equipments Equipment[]
  equipmentCatalogCandidates EquipmentCatalogCandidate[]
  scheduleSlots ScheduleSlot[]
  accessDevices AccessDevice[]
  accessEvents AccessEvent[]
  financialProfile FinancialProfile?
  financialAccounts FinancialAccount[]
  financialCategories FinancialCategory[]
  financialTransactions FinancialTransaction[]
  suppliers Supplier[]
  payables  Payable[]
  subscriptions Subscription[]
  productSubscriptions TenantProductSubscription[]
  productConfigurations TenantProductConfiguration[]
  productPreferences UserProductPreference[]
  charges   Charge[]
  communicationTemplates CommunicationTemplate[]
  communicationAutomations CommunicationAutomation[]
  communicationMessages CommunicationMessage[]
  aggregatorConnections AggregatorProviderConnection[]
  @@index([slug])
}

model Student {
  id              String        @id @default(uuid())
  gymId           String
  userId          String?
  birthDate       DateTime?
  gender          String?
  goal            String?
  level           String?
  status          StudentStatus @default(ACTIVE)
  enrollmentDate  DateTime      @default(now())
  consentHealth   Boolean       @default(false)
  consentComm     Boolean       @default(false)
  consentBiometry Boolean       @default(false)
  gym             Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user            User?   @relation(fields: [userId], references: [id])
  assessments     Assessment[]
  workouts        Workout[]
  schedules       StudentSchedule[]
  accessCredentials AccessCredential[]
  accessEvents    AccessEvent[]
  subscriptions   Subscription[]
  charges         Charge[]
  communicationMessages CommunicationMessage[]
  communicationPreference CommunicationPreference?
  aggregatorMembers AggregatorMember[]
  @@index([gymId])
}

model Assessment {
  id             String   @id @default(uuid())
  studentId      String
  evaluatorId    String?
  weight         Float?
  height         Float?
  bmi            Float?
  bodyFatPercent Float?
  measurements   Json?
  restrictions   Json?
  notes          String?
  createdAt      DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workouts       Workout[]
  @@index([studentId])
}

model EquipmentCatalogItem {
  id                 String                   @id @default(uuid())
  slug               String                   @unique
  name               String
  category           EquipmentCatalogCategory
  aliases            Json?
  primaryMuscle      String?
  secondaryMuscles   Json?
  movementPatterns   Json?
  contraindications  Json?
  metadata           Json?
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  gymEquipments      Equipment[]
  resolvedCandidates EquipmentCatalogCandidate[]
  @@index([category, active])
}

model EquipmentCatalogCandidate {
  id                    String                          @id @default(uuid())
  gymId                 String
  submittedByUserId     String?
  fingerprint           String
  proposedName          String
  proposedCategory      EquipmentCatalogCategory?
  manufacturerName      String?
  modelName             String?
  aliases               Json?
  evidenceUrl           String?
  notes                 String?
  status                EquipmentCatalogCandidateStatus @default(PENDING)
  resolvedCatalogItemId String?
  reviewNotes           String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  gym                   Gym                             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  submittedBy           User?                           @relation("EquipmentCandidateSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy            User?                           @relation("EquipmentCandidateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  resolvedCatalogItem   EquipmentCatalogItem?           @relation(fields: [resolvedCatalogItemId], references: [id], onDelete: SetNull)
  @@unique([gymId, fingerprint])
  @@index([gymId, status, createdAt])
  @@index([status, createdAt])
  @@index([resolvedCatalogItemId])
}

model Equipment {
  id            String @id @default(uuid())
  gymId         String
  catalogItemId String?
  name          String
  standardName  String?
  type          String?
  primaryMuscle String?
  secondaryMuscles Json?
  movementPattern String?
  difficulty    String?
  contraindications Json?
  videoUrl      String?
  active        Boolean @default(true)
  gym           Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  catalogItem   EquipmentCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]
  @@index([gymId])
  @@index([catalogItemId])
  @@unique([gymId, catalogItemId])
}

model Exercise {
  id           String @id @default(uuid())
  name         String @unique
  muscleGroup  String?
  movement     String?
  level        String?
  videoUrl     String?
  contraindications Json?
  workoutExercises WorkoutExercise[]
}

model Workout {
  id            String        @id @default(uuid())
  studentId     String
  assessmentId  String?
  createdByAI   Boolean       @default(false)
  approvedById  String?
  status        WorkoutStatus @default(DRAFT)
  goal          String?
  level         String?
  weeklyFrequency Int?
  startDate     DateTime?
  validUntil    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment    Assessment?   @relation(fields: [assessmentId], references: [id])
  sessions      WorkoutSession[]
  @@index([studentId])
}

model WorkoutSession {
  id          String @id @default(uuid())
  workoutId   String
  name        String
  sessionType String?
  order       Int
  estimatedMinutes Int?
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
}

model WorkoutExercise {
  id            String @id @default(uuid())
  sessionId     String
  exerciseId    String
  equipmentId   String?
  order         Int
  sets          Int?
  reps          String?
  restSeconds   Int?
  suggestedLoad String?
  notes         String?
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  equipment     Equipment?     @relation(fields: [equipmentId], references: [id])
}

model ScheduleSlot {
  id        String @id @default(uuid())
  gymId     String
  weekday   Int
  startTime String
  endTime   String
  capacity  Int
  active    Boolean @default(true)
  gym       Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  schedules StudentSchedule[]
  @@index([gymId])
}

model StudentSchedule {
  id          String         @id @default(uuid())
  studentId   String
  slotId      String
  date        DateTime
  status      ScheduleStatus @default(SCHEDULED)
  checkedInAt DateTime?
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot        ScheduleSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  @@index([studentId])
}

model AccessDevice {
  id              String @id @default(uuid())
  gymId           String
  name            String
  type            AccessType
  protocol        String?
  ipAddress       String?
  active          Boolean @default(true)
  lastSyncAt      DateTime?
  deviceTokenHash String?
  tokenRotatedAt  DateTime?
  gym             Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  events          AccessEvent[]
  scanNonces      AccessScanNonce[]
}

model AccessScanNonce {
  id        String   @id @default(uuid())
  deviceId  String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  device    AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([deviceId, nonce])
  @@index([expiresAt])
}

model AccessCredential {
  id            String   @id @default(uuid())
  studentId     String
  type          AccessType
  tokenHash     String?
  biometricHash String?
  active        Boolean  @default(true)
  expiresAt     DateTime?
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId])
}

model AccessEvent {
  id           String   @id @default(uuid())
  gymId        String
  studentId    String?
  deviceId     String?
  allowed      Boolean
  denialReason String?
  occurredAt   DateTime @default(now())
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student      Student? @relation(fields: [studentId], references: [id])
  device       AccessDevice? @relation(fields: [deviceId], references: [id])
  aggregatorLink AggregatorAccessEventLink?
  @@index([gymId])
}

model FinancialProfile {
  id               String @id @default(uuid())
  gymId            String @unique
  companyName      String
  tradeName        String?
  taxID            String?
  responsibleName  String?
  responsibleEmail String?
  responsiblePhone String?
  status           String @default("pending")
  gym              Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gatewayConnections GatewayConnection[]
}

model GatewayConnection {
  id               String @id @default(uuid())
  profileId        String
  provider         GatewayProvider
  mode             String @default("sandbox")
  authType         String
  merchantId       String?
  accountId        String?
  apiKeyEnc        String?
  accessTokenEnc   String?
  refreshTokenEnc  String?
  webhookSecretEnc String?
  status           String @default("disconnected")
  lastVerifiedAt   DateTime?
  profile          FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FinancialAccount {
  id             String @id @default(uuid())
  gymId          String
  name           String
  type           String
  initialBalance Int    @default(0)
  active         Boolean @default(true)
  gym            Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions   FinancialTransaction[]
}

model FinancialCategory {
  id           String @id @default(uuid())
  gymId        String
  name         String
  type         TransactionType
  color        String?
  active       Boolean @default(true)
  gym          Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  payables     Payable[]
}

model FinancialTransaction {
  id            String            @id @default(uuid())
  gymId         String
  type          TransactionType
  categoryId    String?
  accountId     String?
  description   String
  amount        Int
  dueDate       DateTime?
  paidAt        DateTime?
  status        TransactionStatus @default(PENDING)
  source        String?
  sourceId      String?
  studentId     String?
  supplierId    String?
  paymentMethod String?
  receiptUrl    String?
  createdBy     String?
  createdAt     DateTime @default(now())
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  account       FinancialAccount?  @relation(fields: [accountId], references: [id])
  @@index([gymId])
  @@unique([gymId, source, sourceId])
}

model Supplier {
  id     String @id @default(uuid())
  gymId  String
  name   String
  taxID  String?
  phone  String?
  email  String?
  active Boolean @default(true)
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payables Payable[]
}

model Payable {
  id            String            @id @default(uuid())
  gymId         String
  supplierId    String?
  categoryId    String?
  description   String
  amount        Int
  dueDate       DateTime
  paidAt        DateTime?
  status        TransactionStatus @default(PENDING)
  attachmentUrl String?
  gym           Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  @@index([gymId])
}

model Subscription {
  id            String             @id @default(uuid())
  gymId         String
  studentId     String
  planName      String
  amount        Int
  status        SubscriptionStatus @default(ACTIVE)
  gatewaySubId  String?
  nextBillingAt DateTime?
  startedAt     DateTime @default(now())
  gym           Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charges       Charge[]
  @@index([gymId])
}

model Charge {
  id              String       @id @default(uuid())
  gymId           String
  studentId       String
  subscriptionId  String?
  gatewayChargeId String?
  amount          Int
  dueDate         DateTime?
  paidAt          DateTime?
  status          ChargeStatus @default(PENDING)
  paymentMethod   String?
  pixQrCode       String?
  paymentLink     String?
  gym             Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  @@index([gymId])
}

model CommunicationTemplate {
  id       String @id @default(uuid())
  gymId    String
  name     String
  channel  MessageChannel
  title    String?
  body     String
  variables Json?
  active   Boolean @default(true)
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  messages CommunicationMessage[]
}

model CommunicationAutomation {
  id           String @id @default(uuid())
  gymId        String
  name         String
  triggerEvent String
  conditions   Json?
  actions      Json?
  active       Boolean @default(true)
  gym          Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model CommunicationMessage {
  id           String        @id @default(uuid())
  gymId        String
  studentId    String
  templateId   String?
  channel      MessageChannel
  status       MessageStatus @default(QUEUED)
  title        String?
  body         String
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template     CommunicationTemplate? @relation(fields: [templateId], references: [id])
  @@index([studentId])
}

model CommunicationPreference {
  id                String  @id @default(uuid())
  studentId         String  @unique
  pushEnabled       Boolean @default(true)
  inAppEnabled      Boolean @default(true)
  emailEnabled      Boolean @default(false)
  whatsappEnabled   Boolean @default(false)
  trainingReminders Boolean @default(true)
  paymentReminders  Boolean @default(true)
  marketing         Boolean @default(false)
  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AggregatorProviderConnection {
  id                 String                     @id @default(uuid())
  gymId              String
  providerCode       String
  externalLocationId String?
  status             AggregatorConnectionStatus @default(PENDING)
  capabilities       Json
  configuration      Json?
  contractVersion    String?
  lastVerifiedAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  gym                Gym                        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members            AggregatorMember[]
  settlements        AggregatorSettlement[]
  riskCases          AggregatorRiskCase[]
  @@unique([gymId, providerCode])
  @@index([providerCode, status])
}

model AggregatorMember {
  id               String                       @id @default(uuid())
  connectionId     String
  studentId        String?
  externalMemberId String
  providerStatus   String?
  provenance       Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  connection       AggregatorProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  student          Student?                     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  memberships      AggregatorMembership[]
  agreements       AggregatorAgreement[]
  eligibilityChecks AggregatorEligibilityCheck[]
  visitAuthorizations AggregatorVisitAuthorization[]
  @@unique([connectionId, externalMemberId])
  @@index([studentId])
}

model AggregatorMembership {
  id                   String                     @id @default(uuid())
  memberId             String
  externalMembershipId String?
  status               AggregatorMembershipStatus @default(UNKNOWN)
  planCode             String?
  providerStatus       String?
  validFrom            DateTime?
  validUntil           DateTime?
  verifiedAt           DateTime?
  provenance           Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  member               AggregatorMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eligibilityChecks    AggregatorEligibilityCheck[]
  @@unique([memberId, externalMembershipId])
  @@index([memberId, status])
}

model AggregatorAgreement {
  id                  String                    @id @default(uuid())
  memberId            String
  version             String
  status              AggregatorAgreementStatus @default(REQUIRED)
  documentHash        String?
  signedAt            DateTime?
  supersededAt        DateTime?
  revokedAt           DateTime?
  provenance          Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  member              AggregatorMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitAuthorizations AggregatorVisitAuthorization[]
  @@unique([memberId, version])
  @@index([memberId, status])
}

model AggregatorEligibilityCheck {
  id                  String                      @id @default(uuid())
  memberId            String
  membershipId        String?
  externalCheckId     String?
  status              AggregatorEligibilityStatus @default(UNKNOWN)
  providerStatus      String?
  reasonCode          String?
  verifiedAt          DateTime
  validUntil          DateTime?
  scope               Json?
  provenance          Json?
  createdAt           DateTime                    @default(now())
  member              AggregatorMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership          AggregatorMembership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  visitAuthorizations AggregatorVisitAuthorization[]
  @@unique([memberId, externalCheckId])
  @@index([memberId, status, verifiedAt])
}

model AggregatorVisitAuthorization {
  id                  String                 @id @default(uuid())
  memberId            String
  agreementId         String?
  eligibilityCheckId  String?
  externalVisitId     String?
  status              AggregatorVisitStatus  @default(PENDING)
  requestedAt         DateTime               @default(now())
  authorizedAt        DateTime?
  expiresAt           DateTime?
  denialReason        String?
  provenance          Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  member              AggregatorMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  agreement           AggregatorAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  eligibilityCheck    AggregatorEligibilityCheck? @relation(fields: [eligibilityCheckId], references: [id], onDelete: SetNull)
  accessEventLink     AggregatorAccessEventLink?
  provisionalDecision AggregatorProvisionalDecision?
  revalidationAttempts AggregatorRevalidationAttempt[]
  settlements         AggregatorSettlement[]
  reconciliations     AggregatorReconciliation[]
  riskCases           AggregatorRiskCase[]
  @@unique([memberId, externalVisitId])
  @@index([memberId, status, requestedAt])
}

model AggregatorAccessEventLink {
  id                   String                       @id @default(uuid())
  visitAuthorizationId String                       @unique
  accessEventId        String                       @unique
  linkedAt             DateTime                     @default(now())
  visitAuthorization   AggregatorVisitAuthorization @relation(fields: [visitAuthorizationId], references: [id], onDelete: Cascade)
  accessEvent          AccessEvent                  @relation(fields: [accessEventId], references: [id], onDelete: Cascade)
  reconciliations      AggregatorReconciliation[]
}

model AggregatorProvisionalDecision {
  id                   String                              @id @default(uuid())
  visitAuthorizationId String                              @unique
  status               AggregatorProvisionalDecisionStatus
  policyVersion        String?
  reason               String
  authorizedByUserId   String?
  expiresAt            DateTime?
  metadata             Json?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  visitAuthorization   AggregatorVisitAuthorization       @relation(fields: [visitAuthorizationId], references: [id], onDelete: Cascade)
}

model AggregatorRevalidationAttempt {
  id                   String                       @id @default(uuid())
  visitAuthorizationId String
  attempt              Int
  status               AggregatorRevalidationStatus @default(PENDING)
  externalCheckId      String?
  reasonCode           String?
  provenance           Json?
  attemptedAt          DateTime                     @default(now())
  completedAt          DateTime?
  visitAuthorization   AggregatorVisitAuthorization @relation(fields: [visitAuthorizationId], references: [id], onDelete: Cascade)
  @@unique([visitAuthorizationId, attempt])
  @@index([status, attemptedAt])
}

model AggregatorSettlement {
  id                   String                      @id @default(uuid())
  connectionId         String
  visitAuthorizationId String?
  externalSettlementId String?
  externalVisitId      String?
  status               AggregatorSettlementStatus  @default(EXPECTED)
  amountExpected       Int?
  amountConfirmed      Int?
  currency             String?
  periodStart          DateTime?
  periodEnd            DateTime?
  providerStatus       String?
  provenance           Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  connection           AggregatorProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  visitAuthorization   AggregatorVisitAuthorization? @relation(fields: [visitAuthorizationId], references: [id], onDelete: SetNull)
  reconciliations      AggregatorReconciliation[]
  riskCases            AggregatorRiskCase[]
  @@unique([connectionId, externalSettlementId])
  @@index([connectionId, status])
  @@index([visitAuthorizationId])
}

model AggregatorReconciliation {
  id                   String                         @id @default(uuid())
  visitAuthorizationId String?
  accessEventLinkId    String?
  settlementId         String?
  status               AggregatorReconciliationStatus @default(PENDING)
  details              Json?
  reconciledAt         DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  visitAuthorization   AggregatorVisitAuthorization?  @relation(fields: [visitAuthorizationId], references: [id], onDelete: SetNull)
  accessEventLink      AggregatorAccessEventLink?     @relation(fields: [accessEventLinkId], references: [id], onDelete: SetNull)
  settlement           AggregatorSettlement?          @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  riskCases            AggregatorRiskCase[]
  @@index([status, createdAt])
  @@index([visitAuthorizationId])
  @@index([settlementId])
}

model AggregatorRiskCase {
  id                   String                       @id @default(uuid())
  connectionId         String
  visitAuthorizationId String?
  reconciliationId     String?
  settlementId         String?
  type                 String
  status               AggregatorRiskStatus         @default(OPEN)
  potentialAmount      Int?
  currency             String?
  details              Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  resolvedAt           DateTime?
  connection           AggregatorProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  visitAuthorization   AggregatorVisitAuthorization? @relation(fields: [visitAuthorizationId], references: [id], onDelete: SetNull)
  reconciliation       AggregatorReconciliation?    @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  settlement           AggregatorSettlement?         @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  @@index([connectionId, status])
  @@index([visitAuthorizationId])
}

enum ProductPlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ProductEntitlementKind {
  FEATURE
  LIMIT
  POLICY
}

enum TenantProductSubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

model ProductPlan {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  versions    ProductPlanVersion[]
}

model ProductPlanVersion {
  id                  String                      @id @default(uuid())
  productPlanId       String
  version             Int
  status              ProductPlanVersionStatus    @default(DRAFT)
  publishedAt         DateTime?
  retiredAt           DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  productPlan         ProductPlan                 @relation(fields: [productPlanId], references: [id], onDelete: Restrict)
  entitlements        ProductPlanEntitlement[]
  tenantSubscriptions TenantProductSubscription[]
  @@unique([productPlanId, version])
  @@index([status, publishedAt])
}

model ProductPlanEntitlement {
  id             String                 @id @default(uuid())
  planVersionId  String
  featureKey     String
  kind           ProductEntitlementKind
  featureEnabled Boolean?
  limitValue     Int?
  policyValues   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  planVersion    ProductPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  @@unique([planVersionId, featureKey])
  @@index([featureKey])
}

model TenantProductSubscription {
  id             String                          @id @default(uuid())
  gymId          String
  planVersionId  String
  status         TenantProductSubscriptionStatus @default(ACTIVE)
  effectiveFrom  DateTime                        @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  gym            Gym                             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  planVersion    ProductPlanVersion              @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  @@index([gymId, status])
  @@index([planVersionId, status])
}

model TenantProductConfiguration {
  id             String                 @id @default(uuid())
  gymId          String
  featureKey     String
  kind           ProductEntitlementKind
  featureEnabled Boolean?
  limitValue     Int?
  policyValues   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  gym            Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  @@unique([gymId, featureKey])
  @@index([gymId, kind])
}

model UserProductPreference {
  id             String                 @id @default(uuid())
  gymId          String
  userId         String
  featureKey     String
  kind           ProductEntitlementKind
  featureEnabled Boolean?
  limitValue     Int?
  policyValues   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  gym            Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([gymId, userId, featureKey])
  @@index([gymId, userId])
  @@index([featureKey])
}
