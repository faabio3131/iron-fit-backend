generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTION
  TRAINER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELED
}

enum WorkoutStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  EXPIRED
}

enum ScheduleStatus {
  SCHEDULED
  CHECKED_IN
  NO_SHOW
  CANCELED
}

enum AccessType {
  QR_CODE
  BIOMETRIC
  FACIAL
  TAG
  MANUAL
}

enum GatewayProvider {
  ASAAS
  MERCADO_PAGO
  PAGARME
  STRIPE
  EFI
  GERENCIANET
  IUGU
  VINDI
  MANUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum ChargeStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PLANNED
  PENDING
  PAID
  CANCELED
}

enum MessageChannel {
  PUSH
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELED
}

enum ManagerAlertCategory {
  STUDENT_BILLING
  ATTENDANCE_RISK
  ASSESSMENT_WORKOUT
  EQUIPMENT
  DELIVERY_FAILURE
  INTEGRATION_HEALTH
  PLAN_LIMIT
  SECURITY
  OPERATIONAL_INCIDENT
  HUMAN_APPROVAL
}

enum ManagerAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ManagerAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum ManagerAlertChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
}

enum ManagerAlertDeliveryStatus {
  PENDING
  DEFERRED
  SENDING
  SENT
  FAILED
  DEAD_LETTER
  SKIPPED
}

enum EvolutionTenantInstanceStatus {
  PROVISIONING
  QR_PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum AggregatorConnectionStatus {
  PENDING
  ACTIVE
  DEGRADED
  SUSPENDED
  DISCONNECTED
}

enum AggregatorMembershipStatus {
  UNKNOWN
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

enum AggregatorAgreementStatus {
  REQUIRED
  SIGNED
  SUPERSEDED
  REVOKED
}

enum AggregatorEligibilityStatus {
  UNKNOWN
  ELIGIBLE
  INELIGIBLE
}

enum AggregatorVisitStatus {
  PENDING
  CONFIRMED
  DENIED
  PROVISIONAL
  FAILED
}

enum AggregatorProvisionalDecisionStatus {
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum AggregatorRevalidationStatus {
  PENDING
  CONFIRMED
  FAILED
  UNKNOWN
}

enum AggregatorSettlementStatus {
  EXPECTED
  CONFIRMED
  RECEIVED
  DIVERGENT
  DISPUTED
  EXPIRED
}

enum AggregatorReconciliationStatus {
  PENDING
  RECONCILED
  MISSING_PROVIDER_CHECKIN
  MISSING_PHYSICAL_ENTRY
  UNPAID_RISK
  AMOUNT_DIVERGENCE
  DUPLICATE
  MANUAL_REVIEW
}

enum AggregatorRiskStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum EquipmentCatalogCategory {
  CARDIO
  SELECTORIZED_STRENGTH
  PLATE_LOADED
  CABLE_FUNCTIONAL
  RACKS_BENCHES
  FREE_WEIGHTS
  FUNCTIONAL_CONDITIONING
  PILATES_REHAB
  SPECIALIZED_STRENGTH
}

enum EquipmentCatalogCandidateStatus {
  PENDING
  APPROVED
  MERGED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  name         String
  passwordHash String
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?
  emailVerifiedAt  DateTime?
  passwordChangedAt DateTime?
  active           Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  authActionTokens AuthActionToken[]
  authRecoveryCodes AuthRecoveryCode[]
  userRoles    UserRole[]
  students     Student[]
  auditLogs    AuditLog[]
  productPreferences UserProductPreference[]
  commercialOnboardingCheckpoints CommercialOnboardingCheckpoint[]
  equipmentCandidatesSubmitted EquipmentCatalogCandidate[] @relation("EquipmentCandidateSubmittedBy")
  equipmentCandidatesReviewed  EquipmentCatalogCandidate[] @relation("EquipmentCandidateReviewedBy")
  dataSubjectRequests DataSubjectRequest[]
  legalAcceptances LegalAcceptance[]
  managerAlertRecipients ManagerAlertRecipient[]
  managerAlertPreferences ManagerAlertPreference[]
}


enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  DELETION
  PORTABILITY
  RESTRICTION
  OBJECTION
}

enum DataSubjectRequestStatus {
  OPEN
  IN_REVIEW
  FULFILLED
  REJECTED
  CANCELLED
}

enum LegalDocumentKind {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
}

enum LegalDocumentStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum RetentionAction {
  DELETE
  ANONYMIZE
  REVIEW
}

enum GovernanceRecordStatus {
  DRAFT
  APPROVED
  RETIRED
}

model DataSubjectRequest {
  id             String                   @id @default(uuid())
  userId         String
  type           DataSubjectRequestType
  status         DataSubjectRequestStatus @default(OPEN)
  requestedAt    DateTime                 @default(now())
  operationalDueAt DateTime?
  reviewedAt     DateTime?
  completedAt    DateTime?
  resolutionCode String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, requestedAt])
  @@index([status, operationalDueAt])
}

model LegalDocument {
  id          String              @id @default(uuid())
  kind        LegalDocumentKind
  version     String
  status      LegalDocumentStatus @default(DRAFT)
  contentUrl  String
  contentHash String
  effectiveAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  acceptances LegalAcceptance[]

  @@unique([kind, version])
  @@index([kind, status, effectiveAt])
}

model LegalAcceptance {
  id              String        @id @default(uuid())
  userId          String
  legalDocumentId String
  acceptedAt      DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([userId, acceptedAt])
}

model DataRetentionPolicy {
  id             String                 @id @default(uuid())
  dataClass      String                 @unique
  purposeCode    String
  legalBasisCode String
  retentionDays  Int?
  action         RetentionAction
  status         GovernanceRecordStatus @default(DRAFT)
  approvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, dataClass])
}

model SubprocessorRecord {
  id             String                 @id @default(uuid())
  providerCode   String                 @unique
  purposeCode    String
  dataCategories Json
  processingRegion String?
  privacyUrl     String?
  dpaReference   String?
  status         GovernanceRecordStatus @default(DRAFT)
  approvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, providerCode])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash         String
  previousRefreshTokenHash String?
  deviceName               String?
  ipAddress                String?
  expiresAt                DateTime
  absoluteExpiresAt        DateTime?
  lastUsedAt               DateTime @default(now())
  stepUpExpiresAt          DateTime?
  revokedAt                DateTime?
  createdAt                DateTime @default(now())
}

enum AuthActionTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum AuthActionDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model AuthActionToken {
  id                         String                   @id @default(uuid())
  userId                     String
  kind                       AuthActionTokenKind
  tokenHash                  String                   @unique
  deliveryCiphertext         String?
  deliveryStatus             AuthActionDeliveryStatus @default(PENDING)
  deliveryAttemptCount       Int                      @default(0)
  deliveryNextAttemptAt      DateTime?
  deliveryLastAttemptAt      DateTime?
  deliveryLeaseOwner         String?
  deliveryLeaseUntil         DateTime?
  deliveryProviderCode       String?
  deliveryConnectionId       String?
  deliveryProviderMessageRef String?
  deliveryErrorCode          String?
  deliveredAt                DateTime?
  targetEmail                String?
  expiresAt                  DateTime
  consumedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, consumedAt])
  @@index([expiresAt])
  @@index([deliveryStatus, deliveryNextAttemptAt])
  @@index([deliveryLeaseUntil])
}

model AuthRecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model AuthRateLimitBucket {
  id              String   @id @default(uuid())
  scope           String
  keyHash         String
  windowStartedAt DateTime
  count           Int      @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
  @@unique([scope, keyHash])
  @@index([blockedUntil])
}


model Role {
  id              String           @id @default(uuid())
  name            RoleName         @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  module          String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  gymId      String?
  assignedBy String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  gym        Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  gymId      String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  previous   Json?
  next       Json?
  ipAddress  String?
  deviceInfo String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([gymId])
}

model ManagerAlert {
  id                 String               @id @default(uuid())
  gymId              String
  category           ManagerAlertCategory
  severity           ManagerAlertSeverity
  status             ManagerAlertStatus   @default(OPEN)
  eventKey           String
  deduplicationKey   String
  title              String
  message            String
  resourceType       String?
  resourceId         String?
  metadata           Json?
  occurredAt         DateTime             @default(now())
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  resolvedAt         DateTime?
  resolvedById       String?
  dismissedAt        DateTime?
  dismissedById      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  gym                Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  recipients         ManagerAlertRecipient[]
  deliveries         ManagerAlertDelivery[]

  @@unique([gymId, deduplicationKey])
  @@index([gymId, status, severity, createdAt])
  @@index([gymId, category, occurredAt])
  @@index([resourceType, resourceId])
}

model ManagerAlertRecipient {
  id              String       @id @default(uuid())
  alertId         String
  userId          String
  roleSnapshot    RoleName
  readAt          DateTime?
  acknowledgedAt DateTime?
  createdAt       DateTime     @default(now())
  alert           ManagerAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries      ManagerAlertDelivery[]

  @@unique([alertId, userId])
  @@index([userId, readAt, createdAt])
}

model ManagerAlertPreference {
  id               String                @id @default(uuid())
  gymId            String
  userId           String
  category         ManagerAlertCategory
  inAppEnabled     Boolean               @default(true)
  emailEnabled     Boolean               @default(false)
  pushEnabled      Boolean               @default(false)
  whatsappEnabled  Boolean               @default(false)
  minimumSeverity  ManagerAlertSeverity  @default(INFO)
  quietHoursStart  String?
  quietHoursEnd    String?
  timezone         String                @default("America/Sao_Paulo")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  gym              Gym                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId, category])
  @@index([gymId, category])
}

model ManagerAlertDelivery {
  id                 String                     @id @default(uuid())
  alertId            String
  recipientId        String
  channel            ManagerAlertChannel
  status             ManagerAlertDeliveryStatus @default(PENDING)
  idempotencyKey     String                     @unique
  attemptCount       Int                        @default(0)
  nextAttemptAt      DateTime?
  leaseOwner         String?
  leaseUntil         DateTime?
  providerCode       String?
  providerMessageRef String?
  lastErrorCode      String?
  sentAt             DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  alert              ManagerAlert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  recipient          ManagerAlertRecipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, channel])
  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([alertId, channel])
}

model ManagerAlertPolicy {
  id                    String               @id @default(uuid())
  gymId                 String
  category              ManagerAlertCategory
  emailAllowed          Boolean              @default(false)
  pushAllowed           Boolean              @default(false)
  whatsappAllowed       Boolean              @default(false)
  minimumSeverity       ManagerAlertSeverity @default(INFO)
  criticalEscalationMin Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  gym                   Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, category])
  @@index([gymId])
}

model EvolutionTenantInstance {
  id                     String                        @id @default(uuid())
  gymId                  String                        @unique
  globalConnectionId     String
  instanceName           String                        @unique
  status                 EvolutionTenantInstanceStatus @default(PROVISIONING)
  providerState          String?
  lastStateCheckedAt     DateTime?
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  createdByUserId        String
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  gym                    Gym                           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  globalConnection       IntegrationConnection         @relation(fields: [globalConnectionId], references: [id], onDelete: Restrict)

  @@index([globalConnectionId, status])
}


model CommercialTrialProvisioning {
  requestId          String   @id
  requestFingerprint String
  userId             String
  gymId              String
  subscriptionId     String
  trialStartedAt     DateTime
  trialEndsAt        DateTime
  createdAt          DateTime @default(now())

  @@index([gymId, createdAt])
  @@index([userId, createdAt])
}


model CommercialOnboardingCheckpoint {
  id                String   @id @default(uuid())
  gymId             String
  step              String
  completedByUserId String
  completedAt       DateTime @default(now())
  gym               Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  completedBy       User     @relation(fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@unique([gymId, step])
  @@index([gymId, completedAt])
  @@index([completedByUserId, completedAt])
}

model FmCommandControlPlaneCommand {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  payloadHash    String
  gymId          String
  action         String
  status         String   @default("PROCESSING")
  correlationId  String
  result         Json?
  errorCode      String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?
  gym            Gym      @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@index([gymId, createdAt])
  @@index([status, createdAt])
}


model Gym {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  timezone  String   @default("America/Sao_Paulo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  userRoles UserRole[]
  students  Student[]
  equipments Equipment[]
  equipmentCatalogCandidates EquipmentCatalogCandidate[]
  scheduleSlots ScheduleSlot[]
  accessDevices AccessDevice[]
  accessEvents AccessEvent[]
  financialProfile FinancialProfile?
  financialAccounts FinancialAccount[]
  financialCategories FinancialCategory[]
  financialTransactions FinancialTransaction[]
  suppliers Supplier[]
  payables  Payable[]
  subscriptions Subscription[]
  productSubscriptions TenantProductSubscription[]
  saasBillingAgreements SaasBillingAgreement[]
  saasCheckoutSessions SaasCheckoutSession[]
  saasBillingInvoices SaasInvoice[]
  productConfigurations TenantProductConfiguration[]
  productPreferences UserProductPreference[]
  charges   Charge[]
  fiscalHandoffs FiscalHandoff[]
  fiscalScopeBindings FiscalScopeBinding[]
  communicationTemplates CommunicationTemplate[]
  communicationAutomations CommunicationAutomation[]
  communicationMessages CommunicationMessage[]
  aggregatorConnections AggregatorProviderConnection[]
  commercialOnboardingCheckpoints CommercialOnboardingCheckpoint[]
  fmCommandControlPlaneCommands FmCommandControlPlaneCommand[]
  managerAlerts ManagerAlert[]
  managerAlertPreferences ManagerAlertPreference[]
  managerAlertPolicies ManagerAlertPolicy[]
  evolutionTenantInstance EvolutionTenantInstance?
  @@index([slug])
}

model Student {
  id              String        @id @default(uuid())
  gymId           String
  userId          String?
  birthDate       DateTime?
  gender          String?
  goal            String?
  level           String?
  status          StudentStatus @default(ACTIVE)
  enrollmentDate  DateTime      @default(now())
  consentHealth   Boolean       @default(false)
  consentComm     Boolean       @default(false)
  consentBiometry Boolean       @default(false)
  gym             Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user            User?   @relation(fields: [userId], references: [id])
  assessments     Assessment[]
  workouts        Workout[]
  schedules       StudentSchedule[]
  accessCredentials AccessCredential[]
  accessEvents    AccessEvent[]
  subscriptions   Subscription[]
  charges         Charge[]
  communicationMessages CommunicationMessage[]
  communicationPreference CommunicationPreference?
  aggregatorMembers AggregatorMember[]
  @@index([gymId])
}

model Assessment {
  id             String   @id @default(uuid())
  studentId      String
  evaluatorId    String?
  weight         Float?
  height         Float?
  bmi            Float?
  bodyFatPercent Float?
  measurements   Json?
  restrictions   Json?
  notes          String?
  createdAt      DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workouts       Workout[]
  @@index([studentId])
}

model EquipmentCatalogItem {
  id                 String                   @id @default(uuid())
  slug               String                   @unique
  name               String
  category           EquipmentCatalogCategory
  aliases            Json?
  primaryMuscle      String?
  secondaryMuscles   Json?
  movementPatterns   Json?
  contraindications  Json?
  metadata           Json?
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  gymEquipments      Equipment[]
  resolvedCandidates EquipmentCatalogCandidate[]
  @@index([category, active])
}

model EquipmentCatalogCandidate {
  id                    String                          @id @default(uuid())
  gymId                 String
  submittedByUserId     String?
  fingerprint           String
  proposedName          String
  proposedCategory      EquipmentCatalogCategory?
  manufacturerName      String?
  modelName             String?
  aliases               Json?
  evidenceUrl           String?
  notes                 String?
  status                EquipmentCatalogCandidateStatus @default(PENDING)
  resolvedCatalogItemId String?
  reviewNotes           String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  gym                   Gym                             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  submittedBy           User?                           @relation("EquipmentCandidateSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy            User?                           @relation("EquipmentCandidateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  resolvedCatalogItem   EquipmentCatalogItem?           @relation(fields: [resolvedCatalogItemId], references: [id], onDelete: SetNull)
  @@unique([gymId, fingerprint])
  @@index([gymId, status, createdAt])
  @@index([status, createdAt])
  @@index([resolvedCatalogItemId])
}

model Equipment {
  id            String @id @default(uuid())
  gymId         String
  catalogItemId String?
  name          String
  standardName  String?
  type          String?
  primaryMuscle String?
  secondaryMuscles Json?
  movementPattern String?
  difficulty    String?
  contraindications Json?
  videoUrl      String?
  active        Boolean @default(true)
  operationalStatus String @default("OPERATIONAL")
  operationalStatusChangedAt DateTime?
  gym           Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  catalogItem   EquipmentCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]
  @@index([gymId])
  @@index([catalogItemId])
  @@unique([gymId, catalogItemId])
}

model Exercise {
  id           String @id @default(uuid())
  name         String @unique
  muscleGroup  String?
  movement     String?
  level        String?
  videoUrl     String?
  contraindications Json?
  workoutExercises WorkoutExercise[]
}

model Workout {
  id            String        @id @default(uuid())
  studentId     String
  assessmentId  String?
  createdByAI   Boolean       @default(false)
  approvedById  String?
  status        WorkoutStatus @default(DRAFT)
  goal          String?
  level         String?
  weeklyFrequency Int?
  startDate     DateTime?
  validUntil    DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment    Assessment?   @relation(fields: [assessmentId], references: [id])
  sessions      WorkoutSession[]
  @@index([studentId])
}

model WorkoutSession {
  id          String @id @default(uuid())
  workoutId   String
  name        String
  sessionType String?
  order       Int
  estimatedMinutes Int?
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
}

model WorkoutExercise {
  id            String @id @default(uuid())
  sessionId     String
  exerciseId    String
  equipmentId   String?
  order         Int
  sets          Int?
  reps          String?
  restSeconds   Int?
  suggestedLoad String?
  notes         String?
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  equipment     Equipment?     @relation(fields: [equipmentId], references: [id])
}

model ScheduleSlot {
  id        String @id @default(uuid())
  gymId     String
  weekday   Int
  startTime String
  endTime   String
  capacity  Int
  active    Boolean @default(true)
  gym       Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  schedules StudentSchedule[]
  @@index([gymId])
}

model StudentSchedule {
  id          String         @id @default(uuid())
  studentId   String
  slotId      String
  date        DateTime
  status      ScheduleStatus @default(SCHEDULED)
  checkedInAt DateTime?
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot        ScheduleSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  @@index([studentId])
}

model AccessDevice {
  id              String @id @default(uuid())
  gymId           String
  name            String
  type            AccessType
  protocol        String?
  ipAddress       String?
  active          Boolean @default(true)
  lastSyncAt      DateTime?
  deviceTokenHash String?
  tokenRotatedAt  DateTime?
  gym             Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  events          AccessEvent[]
  scanNonces      AccessScanNonce[]
}

model AccessScanNonce {
  id        String   @id @default(uuid())
  deviceId  String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  device    AccessDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([deviceId, nonce])
  @@index([expiresAt])
}

model AccessCredential {
  id            String   @id @default(uuid())
  studentId     String
  type          AccessType
  tokenHash     String?
  biometricHash String?
  active        Boolean  @default(true)
  expiresAt     DateTime?
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId])
}

model AccessEvent {
  id           String   @id @default(uuid())
  gymId        String
  studentId    String?
  deviceId     String?
  allowed      Boolean
  denialReason String?
  occurredAt   DateTime @default(now())
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student      Student? @relation(fields: [studentId], references: [id])
  device       AccessDevice? @relation(fields: [deviceId], references: [id])
  aggregatorLink AggregatorAccessEventLink?
  @@index([gymId])
}

model FinancialProfile {
  id               String @id @default(uuid())
  gymId            String @unique
  companyName      String
  tradeName        String?
  taxID            String?
  responsibleName  String?
  responsibleEmail String?
  responsiblePhone String?
  status           String @default("pending")
  gym              Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gatewayConnections GatewayConnection[]
}

model GatewayConnection {
  id               String @id @default(uuid())
  profileId        String
  provider         GatewayProvider
  mode             String @default("sandbox")
  authType         String
  merchantId       String?
  accountId        String?
  status           String @default("disconnected")
  lastVerifiedAt   DateTime?
  profile          FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FinancialAccount {
  id             String @id @default(uuid())
  gymId          String
  name           String
  type           String
  initialBalance Int    @default(0)
  active         Boolean @default(true)
  gym            Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions   FinancialTransaction[]
}

model FinancialCategory {
  id           String @id @default(uuid())
  gymId        String
  name         String
  type         TransactionType
  color        String?
  active       Boolean @default(true)
  gym          Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  payables     Payable[]
}

// Signed, tenant-scoped provider notifications. No raw payload or secrets are stored.
// A webhook never has authority to mark a charge paid.
// Explicit OWNER-controlled automation policy. Disabled until configured.
model TenantPaymentReconciliationPolicy {
  gymId             String   @id
  accountId         String
  enabled           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedByUserId   String?
}

model TenantPaymentWebhookInbox {
  id                String   @id @default(uuid())
  gymId             String
  connectionId      String
  providerCode      String
  providerEventId   String
  eventType         String
  providerObjectRef String?
  chargeId          String?
  status            String   @default("RECEIVED")
  attemptCount      Int      @default(0)
  nextAttemptAt     DateTime @default(now())
  receivedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([connectionId, providerEventId])
  @@index([gymId, receivedAt])
  @@index([gymId, status])
  @@index([status, nextAttemptAt])
}

model FinancialTransaction {
  id            String            @id @default(uuid())
  gymId         String
  type          TransactionType
  categoryId    String?
  accountId     String?
  description   String
  amount        Int
  dueDate       DateTime?
  paidAt        DateTime?
  status        TransactionStatus @default(PENDING)
  source        String?
  sourceId      String?
  studentId     String?
  supplierId    String?
  paymentMethod String?
  receiptUrl    String?
  createdBy     String?
  createdAt     DateTime @default(now())
  gym           Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  account       FinancialAccount?  @relation(fields: [accountId], references: [id])
  @@index([gymId])
  @@unique([gymId, source, sourceId])
}

model Supplier {
  id     String @id @default(uuid())
  gymId  String
  name   String
  taxID  String?
  phone  String?
  email  String?
  active Boolean @default(true)
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payables Payable[]
}

model Payable {
  id            String            @id @default(uuid())
  gymId         String
  supplierId    String?
  categoryId    String?
  description   String
  amount        Int
  dueDate       DateTime
  paidAt        DateTime?
  status        TransactionStatus @default(PENDING)
  attachmentUrl String?
  gym           Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  @@index([gymId])
}

model Subscription {
  id            String             @id @default(uuid())
  gymId         String
  studentId     String
  planName      String
  amount        Int
  status        SubscriptionStatus @default(ACTIVE)
  gatewaySubId  String?
  nextBillingAt DateTime?
  startedAt     DateTime @default(now())
  gym           Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charges       Charge[]
  @@index([gymId])
}

model Charge {
  id                       String       @id @default(uuid())
  gymId                    String
  studentId                String
  subscriptionId           String?
  gatewayProviderCode      String?
  gatewayConnectionId      String?
  gatewayRequestId         String?      @unique
  gatewayChargeId          String?
  gatewayCheckoutExpiresAt DateTime?
  amount                   Int
  dueDate                  DateTime?
  paidAt                   DateTime?
  status                   ChargeStatus @default(PENDING)
  paymentMethod            String?
  pixQrCode                String?
  paymentLink              String?
  gym                      Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student                  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription             Subscription? @relation(fields: [subscriptionId], references: [id])
  gatewayConnection        IntegrationConnection? @relation(fields: [gatewayConnectionId], references: [id], onDelete: SetNull)
  fiscalHandoff            FiscalHandoff?

  @@index([gymId])
  @@index([gymId, status])
  @@index([gatewayConnectionId, status])
  @@unique([gatewayProviderCode, gatewayChargeId])
}

enum FiscalHandoffStatus {
  PENDING_CAPABILITY
  READY_TO_ISSUE
  SUBMITTED
  AUTHORIZED
  REJECTED
  RECONCILIATION_PENDING
  RECONCILED
  CANCELLATION_PENDING
  CANCELLED
  FAILED
}

model FiscalScopeBinding {
  id               String                 @id @default(uuid())
  gymId            String
  environment      IntegrationEnvironment
  externalTenantId String
  externalUnitId   String
  active           Boolean                @default(true)
  createdByUserId  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  gym              Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, environment])
  @@index([environment, active])
}

model FiscalHandoff {
  id                        String              @id @default(uuid())
  gymId                     String
  chargeId                  String              @unique
  transactionId             String              @unique
  idempotencyKey            String              @unique
  contractVersion           String
  hostNamespace             String
  packId                    String
  useCaseId                 String
  operationKind             String
  documentKind              String
  amountMinor               Int
  currency                  String              @default("BRL")
  paymentMethod             String?
  settledAt                 DateTime?
  status                    FiscalHandoffStatus @default(PENDING_CAPABILITY)
  capabilityVersion         String?
  providerRequestId         String?
  providerDocumentId        String?
  providerAccessKey         String?
  providerProtocolReference String?
  cancellationRequestId     String?
  cancellationJustification  String?
  cancellationProtocolReference String?
  cancellationRejectionCode String?
  cancellationRejectionMessage String?
  reconciliationFingerprint String?
  reconciliationIssueCodes  Json?
  bridgeConnectionId        String?
  attemptCount              Int                 @default(0)
  nextAttemptAt             DateTime?
  lastAttemptAt             DateTime?
  dispatchLeaseOwner        String?
  dispatchLeaseUntil        DateTime?
  lastErrorCode             String?
  authorizedAt              DateTime?
  cancelledAt               DateTime?
  reconciledAt              DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  gym                       Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  charge                    Charge              @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  bridgeConnection          IntegrationConnection? @relation(fields: [bridgeConnectionId], references: [id], onDelete: SetNull)

  @@index([gymId, status])
  @@index([status, nextAttemptAt])
  @@index([dispatchLeaseUntil])
  @@index([bridgeConnectionId, status])
  @@index([providerDocumentId])
  @@index([providerAccessKey])
}

model CommunicationTemplate {
  id       String @id @default(uuid())
  gymId    String
  name     String
  channel  MessageChannel
  title    String?
  body     String
  variables Json?
  active   Boolean @default(true)
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  messages CommunicationMessage[]
}

model CommunicationAutomation {
  id           String @id @default(uuid())
  gymId        String
  name         String
  triggerEvent String
  conditions   Json?
  actions      Json?
  active       Boolean @default(true)
  gym          Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model CommunicationMessage {
  id                   String        @id @default(uuid())
  gymId                String
  studentId            String
  templateId           String?
  channel              MessageChannel
  status               MessageStatus @default(QUEUED)
  title                String?
  body                 String
  dispatchKey          String        @unique
  providerCode         String?
  providerConnectionId String?
  providerMessageRef   String?
  attemptCount         Int           @default(0)
  nextAttemptAt        DateTime?
  lastAttemptAt        DateTime?
  dispatchLeaseOwner   String?
  dispatchLeaseUntil   DateTime?
  lastErrorCode        String?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  errorMessage         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  gym                   Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template              CommunicationTemplate? @relation(fields: [templateId], references: [id])
  providerConnection    IntegrationConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([gymId, channel, status])
  @@index([status, nextAttemptAt])
  @@index([dispatchLeaseUntil])
  @@index([providerConnectionId, status])
}

model CommunicationPreference {
  id                String  @id @default(uuid())
  studentId         String  @unique
  pushEnabled       Boolean @default(true)
  inAppEnabled      Boolean @default(true)
  emailEnabled      Boolean @default(false)
  whatsappEnabled   Boolean @default(false)
  trainingReminders Boolean @default(true)
  paymentReminders  Boolean @default(true)
  marketing         Boolean @default(false)
  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AggregatorProviderConnection {
  id                 String                     @id @default(uuid())
  gymId              String
  providerCode       String
  externalLocationId String?
  status             AggregatorConnectionStatus @default(PENDING)
  capabilities       Json
  configuration      Json?
  contractVersion    String?
  lastVerifiedAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  gym                Gym                        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members            AggregatorMember[]
  settlements        AggregatorSettlement[]
  riskCases          AggregatorRiskCase[]
  @@unique([gymId, providerCode])
  @@index([providerCode, status])
}

model AggregatorMember {
  id               String                       @id @default(uuid())
  connectionId     String
  studentId        String?
  externalMemberId String
  providerStatus   String?
  provenance       Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  connection       AggregatorProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  student          Student?                     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  memberships      AggregatorMembership[]
  agreements       AggregatorAgreement[]
  eligibilityChecks AggregatorEligibilityCheck[]
  visitAuthorizations AggregatorVisitAuthorization[]
  @@unique([connectionId, externalMemberId])
  @@index([studentId])
}

model AggregatorMembership {
  id                   String                     @id @default(uuid())
  memberId             String
  externalMembershipId String?
  status               AggregatorMembershipStatus @default(UNKNOWN)
  planCode             String?
  providerStatus       String?
  validFrom            DateTime?
  validUntil           DateTime?
  verifiedAt           DateTime?
  provenance           Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  member               AggregatorMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eligibilityChecks    AggregatorEligibilityCheck[]
  @@unique([memberId, externalMembershipId])
  @@index([memberId, status])
}

model AggregatorAgreement {
  id                  String                    @id @default(uuid())
  memberId            String
  version             String
  status              AggregatorAgreementStatus @default(REQUIRED)
  documentHash        String?
  signedAt            DateTime?
  supersededAt        DateTime?
  revokedAt           DateTime?
  provenance          Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  member              AggregatorMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitAuthorizations AggregatorVisitAuthorization[]
  @@unique([memberId, version])
  @@index([memberId, status])
}

model AggregatorEligibilityCheck {
  id                  String                      @id @default(uuid())
  memberId            String
  membershipId        String?
  externalCheckId     String?
  status              AggregatorEligibilityStatus @default(UNKNOWN)
  providerStatus      String?
  reasonCode          String?
  verifiedAt          DateTime
  validUntil          DateTime?
  scope               Json?
  provenance          Json?
  createdAt           DateTime                    @default(now())
  member              AggregatorMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership          AggregatorMembership?       @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  visitAuthorizations AggregatorVisitAuthorization[]
  @@unique([memberId, externalCheckId])
  @@index([memberId, status, verifiedAt])
}

model AggregatorVisitAuthorization {
  id                  String                 @id @default(uuid())
  memberId            String
  agreementId         String?
  eligibilityCheckId  String?
  externalVisitId     String?
  status              AggregatorVisitStatus  @default(PENDING)
  requestedAt         DateTime               @default(now())
  authorizedAt        DateTime?
  expiresAt           DateTime?
  denialReason        String?
  provenance          Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  member              AggregatorMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  agreement           AggregatorAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  eligibilityCheck    AggregatorEligibilityCheck? @relation(fields: [eligibilityCheckId], references: [id], onDelete: SetNull)
  accessEventLink     AggregatorAccessEventLink?
  provisionalDecision AggregatorProvisionalDecision?
  revalidationAttempts AggregatorRevalidationAttempt[]
  settlements         AggregatorSettlement[]
  reconciliations     AggregatorReconciliation[]
  riskCases           AggregatorRiskCase[]
  @@unique([memberId, externalVisitId])
  @@index([memberId, status, requestedAt])
}

model AggregatorAccessEventLink {
  id                   String                       @id @default(uuid())
  visitAuthorizationId String                       @unique
  accessEventId        String                       @unique
  linkedAt             DateTime                     @default(now())
  visitAuthorization   AggregatorVisitAuthorization @relation(fields: [visitAuthorizationId], references: [id], onDelete: Cascade)
  accessEvent          AccessEvent                  @relation(fields: [accessEventId], references: [id], onDelete: Cascade)
  reconciliations      AggregatorReconciliation[]
}

model AggregatorProvisionalDecision {
  id                   String                              @id @default(uuid())
  visitAuthorizationId String                              @unique
  status               AggregatorProvisionalDecisionStatus
  policyVersion        String?
  reason               String
  authorizedByUserId   String?
  expiresAt            DateTime?
  metadata             Json?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  visitAuthorization   AggregatorVisitAuthorization       @relation(fields: [visitAuthorizationId], references: [id], onDelete: Cascade)
}

model AggregatorRevalidationAttempt {
  id                   String                       @id @default(uuid())
  visitAuthorizationId String
  attempt              Int
  status               AggregatorRevalidationStatus @default(PENDING)
  externalCheckId      String?
  reasonCode           String?
  provenance           Json?
  attemptedAt          DateTime                     @default(now())
  completedAt          DateTime?
  visitAuthorization   AggregatorVisitAuthorization @relation(fields: [visitAuthorizationId], references: [id], onDelete: Cascade)
  @@unique([visitAuthorizationId, attempt])
  @@index([status, attemptedAt])
}

model AggregatorSettlement {
  id                   String                      @id @default(uuid())
  connectionId         String
  visitAuthorizationId String?
  externalSettlementId String?
  externalVisitId      String?
  status               AggregatorSettlementStatus  @default(EXPECTED)
  amountExpected       Int?
  amountConfirmed      Int?
  currency             String?
  periodStart          DateTime?
  periodEnd            DateTime?
  providerStatus       String?
  provenance           Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  connection           AggregatorProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  visitAuthorization   AggregatorVisitAuthorization? @relation(fields: [visitAuthorizationId], references: [id], onDelete: SetNull)
  reconciliations      AggregatorReconciliation[]
  riskCases            AggregatorRiskCase[]
  @@unique([connectionId, externalSettlementId])
  @@index([connectionId, status])
  @@index([visitAuthorizationId])
}

model AggregatorReconciliation {
  id                   String                         @id @default(uuid())
  visitAuthorizationId String?
  accessEventLinkId    String?
  settlementId         String?
  status               AggregatorReconciliationStatus @default(PENDING)
  details              Json?
  reconciledAt         DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  visitAuthorization   AggregatorVisitAuthorization?  @relation(fields: [visitAuthorizationId], references: [id], onDelete: SetNull)
  accessEventLink      AggregatorAccessEventLink?     @relation(fields: [accessEventLinkId], references: [id], onDelete: SetNull)
  settlement           AggregatorSettlement?          @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  riskCases            AggregatorRiskCase[]
  @@index([status, createdAt])
  @@index([visitAuthorizationId])
  @@index([settlementId])
}

model AggregatorRiskCase {
  id                   String                       @id @default(uuid())
  connectionId         String
  visitAuthorizationId String?
  reconciliationId     String?
  settlementId         String?
  type                 String
  status               AggregatorRiskStatus         @default(OPEN)
  potentialAmount      Int?
  currency             String?
  details              Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  resolvedAt           DateTime?
  connection           AggregatorProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  visitAuthorization   AggregatorVisitAuthorization? @relation(fields: [visitAuthorizationId], references: [id], onDelete: SetNull)
  reconciliation       AggregatorReconciliation?    @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  settlement           AggregatorSettlement?         @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  @@index([connectionId, status])
  @@index([visitAuthorizationId])
}

enum ProductPlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ProductEntitlementKind {
  FEATURE
  LIMIT
  POLICY
}

enum TenantProductSubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SaasBillingInterval {
  MONTHLY
  YEARLY
}

enum SaasBillingAgreementStatus {
  PENDING_CHECKOUT
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum SaasCheckoutStatus {
  PENDING
  READY
  COMPLETED
  EXPIRED
  CANCELED
  FAILED
}

enum SaasInvoiceStatus {
  OPEN
  PAID
  VOID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SaasPaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SaasRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SaasWebhookStatus {
  RECEIVED
  PROCESSED
  REJECTED
  FAILED
}

enum SaasReconciliationStatus {
  MATCHED
  MISMATCH
}

model ProductPlan {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  versions    ProductPlanVersion[]
}

model ProductPlanVersion {
  id                  String                      @id @default(uuid())
  productPlanId       String
  version             Int
  status              ProductPlanVersionStatus    @default(DRAFT)
  publishedAt         DateTime?
  retiredAt           DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  productPlan         ProductPlan                 @relation(fields: [productPlanId], references: [id], onDelete: Restrict)
  entitlements        ProductPlanEntitlement[]
  tenantSubscriptions TenantProductSubscription[]
  saasPrices            SaasPlanPrice[]
  @@unique([productPlanId, version])
  @@index([status, publishedAt])
}

model ProductPlanEntitlement {
  id             String                 @id @default(uuid())
  planVersionId  String
  featureKey     String
  kind           ProductEntitlementKind
  featureEnabled Boolean?
  limitValue     Int?
  policyValues   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  planVersion    ProductPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  capability     ProductCapabilityDefinition @relation(fields: [featureKey], references: [key], onDelete: Restrict, onUpdate: Restrict)
  @@unique([planVersionId, featureKey])
  @@index([featureKey])
}

model TenantProductSubscription {
  id             String                          @id @default(uuid())
  gymId          String
  planVersionId  String
  status         TenantProductSubscriptionStatus @default(ACTIVE)
  effectiveFrom  DateTime                        @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  gym            Gym                             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  planVersion    ProductPlanVersion              @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  saasBillingAgreement SaasBillingAgreement?
  @@index([gymId, status])
  @@index([planVersionId, status])
}

model SaasPlanPrice {
  id             String              @id @default(uuid())
  priceCode      String              @unique
  planVersionId  String
  currency       String              @default("BRL")
  amountMinor    Int
  interval       SaasBillingInterval
  active         Boolean             @default(true)
  effectiveFrom  DateTime            @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  planVersion    ProductPlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  agreements     SaasBillingAgreement[]
  checkoutSessions SaasCheckoutSession[]
  invoices       SaasInvoice[]
  @@index([planVersionId, active])
  @@index([currency, interval, active])
}

model SaasBillingAgreement {
  id                          String                     @id @default(uuid())
  gymId                       String
  tenantProductSubscriptionId String                     @unique
  priceId                     String?
  status                      SaasBillingAgreementStatus @default(PENDING_CHECKOUT)
  providerCode                String
  providerCustomerRef         String?
  providerSubscriptionRef     String?
  currentPeriodStart          DateTime?
  currentPeriodEnd            DateTime?
  nextBillingAt               DateTime?
  cancelAtPeriodEnd           Boolean                    @default(false)
  canceledAt                  DateTime?
  pastDueSince                DateTime?
  pendingTransition           Json?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  gym                         Gym                        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  productSubscription         TenantProductSubscription  @relation(fields: [tenantProductSubscriptionId], references: [id], onDelete: Restrict)
  price                       SaasPlanPrice?             @relation(fields: [priceId], references: [id], onDelete: Restrict)
  checkoutSessions            SaasCheckoutSession[]
  invoices                    SaasInvoice[]
  reconciliations             SaasBillingReconciliation[]
  @@unique([providerCode, providerSubscriptionRef])
  @@index([gymId, status])
  @@index([status, nextBillingAt])
}

model SaasCheckoutSession {
  id                 String             @id @default(uuid())
  requestId          String             @unique
  gymId              String
  agreementId        String
  priceId            String
  providerCode       String
  providerSessionRef String?
  checkoutUrl        String?
  status             SaasCheckoutStatus @default(PENDING)
  amountMinor        Int
  currency           String
  expiresAt          DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  gym                Gym                @relation(fields: [gymId], references: [id], onDelete: Restrict)
  agreement          SaasBillingAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  price              SaasPlanPrice      @relation(fields: [priceId], references: [id], onDelete: Restrict)
  @@unique([providerCode, providerSessionRef])
  @@index([gymId, status, createdAt])
  @@index([agreementId, status])
}

model SaasInvoice {
  id                 String            @id @default(uuid())
  idempotencyKey     String            @unique
  agreementId        String
  gymId              String
  priceId            String
  providerCode       String
  providerInvoiceRef String?
  periodStart        DateTime
  periodEnd          DateTime
  amountDueMinor     Int
  amountPaidMinor    Int               @default(0)
  currency           String
  status             SaasInvoiceStatus @default(OPEN)
  dueAt              DateTime
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  agreement          SaasBillingAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  gym                Gym               @relation(fields: [gymId], references: [id], onDelete: Restrict)
  price              SaasPlanPrice     @relation(fields: [priceId], references: [id], onDelete: Restrict)
  payments           SaasPayment[]
  refunds            SaasRefund[]
  reconciliations    SaasBillingReconciliation[]
  @@unique([providerCode, providerInvoiceRef])
  @@index([gymId, status, dueAt])
  @@index([agreementId, periodStart])
}

model SaasPayment {
  id                 String            @id @default(uuid())
  invoiceId          String
  providerCode       String
  providerPaymentRef String
  amountMinor        Int
  currency           String
  status             SaasPaymentStatus
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  invoice            SaasInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds            SaasRefund[]
  @@unique([providerCode, providerPaymentRef])
  @@index([invoiceId, status])
}

model SaasRefund {
  id                String           @id @default(uuid())
  requestId         String           @unique
  invoiceId         String
  paymentId         String?
  providerCode      String
  providerRefundRef String?
  amountMinor       Int
  status            SaasRefundStatus @default(PENDING)
  reason            String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  invoice           SaasInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment           SaasPayment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([providerCode, providerRefundRef])
  @@index([invoiceId, status])
}

model SaasWebhookEvent {
  id              String            @id @default(uuid())
  providerCode    String
  providerEventId String
  eventType       String
  payloadHash     String
  status          SaasWebhookStatus @default(RECEIVED)
  errorCode       String?
  receivedAt      DateTime          @default(now())
  processedAt     DateTime?
  @@unique([providerCode, providerEventId])
  @@index([status, receivedAt])
}

model SaasBillingReconciliation {
  id                  String                   @id @default(uuid())
  agreementId         String
  invoiceId           String?
  status              SaasReconciliationStatus
  expectedAmountMinor Int?
  observedAmountMinor Int?
  details             Json?
  checkedAt           DateTime                 @default(now())
  agreement           SaasBillingAgreement     @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  invoice             SaasInvoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@index([agreementId, checkedAt])
  @@index([status, checkedAt])
}

model TenantProductConfiguration {
  id             String                 @id @default(uuid())
  gymId          String
  featureKey     String
  kind           ProductEntitlementKind
  featureEnabled Boolean?
  limitValue     Int?
  policyValues   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  gym            Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  capability     ProductCapabilityDefinition @relation(fields: [featureKey], references: [key], onDelete: Restrict, onUpdate: Restrict)
  @@unique([gymId, featureKey])
  @@index([gymId, kind])
}

model UserProductPreference {
  id             String                 @id @default(uuid())
  gymId          String
  userId         String
  featureKey     String
  kind           ProductEntitlementKind
  featureEnabled Boolean?
  limitValue     Int?
  policyValues   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  gym            Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability     ProductCapabilityDefinition @relation(fields: [featureKey], references: [key], onDelete: Restrict, onUpdate: Restrict)
  @@unique([gymId, userId, featureKey])
  @@index([gymId, userId])
  @@index([featureKey])
}
